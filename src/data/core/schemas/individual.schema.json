{
  "$id": "mochiichao/individual/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "deviations": {
      "items": {
        "properties": {
          "consistency": {
            "const": "MUST REPRODUCE in every generation of this individual"
          },
          "individual_value": {
            "type": "string"
          },
          "ruled_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "ruled_on": {
            "format": "date",
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "species_pattern": {
            "type": "string"
          },
          "status": {
            "enum": [
              "RULED",
              "PROPOSED",
              "SPECIES-TYPICAL"
            ]
          },
          "trait": {
            "type": "string"
          }
        },
        "required": [
          "trait",
          "species_pattern",
          "individual_value",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "individual_id": {
      "type": "string"
    },
    "personality_seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "species": {
      "type": "string"
    },
    "variance": {
      "properties": {
        "size_class": {
          "enum": [
            "small",
            "standard",
            "large"
          ]
        },
        "stats": {
          "properties": {
            "atk": {
              "maximum": 15,
              "minimum": 0,
              "type": "integer"
            },
            "def": {
              "maximum": 15,
              "minimum": 0,
              "type": "integer"
            },
            "hp": {
              "maximum": 15,
              "minimum": 0,
              "type": "integer"
            },
            "spa": {
              "maximum": 15,
              "minimum": 0,
              "type": "integer"
            },
            "spd": {
              "maximum": 15,
              "minimum": 0,
              "type": "integer"
            },
            "spe": {
              "maximum": 15,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "hp",
            "atk",
            "def",
            "spa",
            "spd",
            "spe"
          ],
          "type": "object"
        },
        "temperament_read": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "stats",
        "size_class"
      ],
      "type": "object"
    },
    "honours": {
      "type": "array",
      "description": "#104 individual honours: STORED stamps on the individual record (shape: show/production/species-data/honours-fragment.json). A stamp without a resolvable earning fact is a data error. The honour catalogue itself is OPEN owner content.",
      "items": {
        "type": "object"
      }
    },
    "location": {
      "enum": [
        "party",
        "garden",
        "storage",
        null
      ],
      "description": "#106 storage: ONE field on the roster record — storage is a view over the roster, not a second database; the three kinds make double-placement impossible. Release is a tombstone fact in save history and never reverts #14's kept state."
    },
    "keeperHistory": {
      "type": "array",
      "description": "#168 keeper history (seat chosen at the List 18 landing: the individual record, where #80's model lives — ONE home; #68's protocol doc cross-references this field). Each entry records a transfer of care under 168-RANGER-TRADING.md; escrow state is part of the transfer record, and while a record is escrowed no release and no location move may be written for it (escrow-lock).",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "individual_id",
    "species",
    "personality_seed",
    "variance",
    "deviations"
  ],
  "title": "Mochi individual record — variance + ruled deviations (List 9, #80). Deviation entries with status RULED require ruled_by/ruled_on/source; generators may only read RULED deviations. Deviations are feature-level only — palette variation per individual is prohibited by the Lustre Law and has no field here.",
  "type": "object"
}